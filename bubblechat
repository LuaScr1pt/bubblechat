-- Mesaj Gönderme Mantığı
SendBtn.MouseButton1Click:Connect(function()
    local targetName = UserInput.Text
    local targetMessage = MsgInput.Text

    if targetName ~= "" and targetMessage ~= "" then
        -- Oyuncuyu ve Karakterini Bul
        local targetPlayer = Players:FindFirstChild(targetName)
        if not targetPlayer then
            -- DisplayName olarak girilmişse bul
            for _, p in pairs(Players:GetPlayers()) do
                if string.lower(p.DisplayName) == string.lower(targetName) or string.lower(p.Name) == string.lower(targetName) then
                    targetPlayer = p
                    targetName = p.Name
                    break
                end
            end
        end
        
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Head") then
            -- 1. Kafa Üstünde Konuşma Balonu Çıkar
            pcall(function()
                Chat:Chat(targetPlayer.Character.Head, targetMessage, Enum.ChatColor.White)
            end)
        end

        -- 2. Sol Üstteki Chat Kutusu İçin
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if generalChannel then
                generalChannel:DisplaySystemMessage("<font color='#FFFFFF'><b>[" .. targetName .. "]:</b> " .. targetMessage .. "</font>")
            end
        else
            pcall(function()
                StarterGui:SetCore("ChatMakeSystemMessage", {
                    Text = "[" .. targetName .. "]: " .. targetMessage,
                    Color = Color3.fromRGB(255, 255, 255),
                    Font = Enum.Font.SourceSansBold,
                    TextSize = 18
                })
            end)
        end

        MsgInput.Text = "" -- Mesaj alanını temizle
    end
end)
