-- 1. INSERT TUŞU İLE AÇMA / KAPAMA
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.Insert then
        Frame.Visible = not Frame.Visible
    end
end)

-- Sunucudaki isimle eşleşen oyuncuyu bulma fonksiyonu
local function getMatchingPlayer(text)
    if text == "" then return nil end
    text = string.lower(text)
    
    for _, plr in pairs(Players:GetPlayers()) do
        -- Hem Kullanıcı Adı (Name) hem de Ekran Adı (DisplayName) kontrol edilir
        if string.sub(string.lower(plr.Name), 1, #text) == text then
            return plr.Name
        elseif string.sub(string.lower(plr.DisplayName), 1, #text) == text then
            return plr.Name
        end
    end
    return nil
end

-- 2. OTOMATİK İSİM TAMAMLAMA (Yazarken TAB veya Focus Lost ile tamamlama)
UserInput:GetPropertyChangedSignal("Text"):Connect(function()
    if UserInput:IsFocused() then
        local match = getMatchingPlayer(UserInput.Text)
        if match and #UserInput.Text > 0 then
            -- Yazılan kısım haricindeki tamamlanan yer seçilebilir mantık
        end
    end
end)

UserInput.FocusLost:Connect(function(enterPressed, inputThatCausedFocusLost)
    local match = getMatchingPlayer(UserInput.Text)
    if match then
        UserInput.Text = match
    end
end)

